# Copia este archivo como .env y completa los valores localmente.
# Nunca publiques el archivo .env ni compartas sus secretos.

# Genera un secreto aleatorio de al menos 32 caracteres.
# Ejemplo de generación: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REEMPLAZA_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES_HEXADECIMALES

# Cuenta administrativa inicial (opcional). Usa una contraseña única de al menos 16 caracteres.
# En cada arranque, si se configura, esta contraseña se sincroniza con esa cuenta.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@tu-dominio.example
ADMIN_PASSWORD=REEMPLAZA_POR_UNA_CONTRASENA_UNICA_DE_AL_MENOS_16_CARACTERES

# Necesaria para las funciones de IA.
GEMINI_API_KEY=

# Opcional: ruta de la base SQLite.
DATABASE_PATH=legal.db

# Los registros jurídicos/financieros de demostración solo se crean si lo activas explícitamente.
SEED_DEMO_DATA=false
